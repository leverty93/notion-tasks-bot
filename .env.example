# --- Telegram ---
# Токен от @BotFather
BOT_TOKEN=
# Твой числовой Telegram user id (узнать: @userinfobot). Бот отвечает только ему.
ALLOWED_USER_ID=

# --- Notion ---
# Internal integration token (https://www.notion.so/profile/integrations)
NOTION_TOKEN=
# ID data source базы задач (как найти — см. README)
NOTION_DATA_SOURCE_ID=

# --- LLM (OpenRouter, OpenAI-совместимый API) ---
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
# Слаг модели, например: vendor/model-name:free
# Можно перечислить несколько через запятую — если первая недоступна (404/429),
# бот возьмёт следующую. Бесплатные модели на OpenRouter часто исчезают.
LLM_MODEL=

# --- Расписание ---
# Понедельник недели А (от него считается чётность недель)
WEEK_A_MONDAY=2026-08-31

# --- Прочее ---
LOG_LEVEL=INFO
